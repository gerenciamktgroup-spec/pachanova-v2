# PachaNova V2.0 — Environment Variables Template

# 1. Supabase Database & API Config
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Supabase Cloud Database Connection (PGBouncer Pooler URL for Serverless)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# 2. Authentication (NextAuth)
AUTH_SECRET="your-next-auth-secret-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Payments (MercadoPago)
MERCADOPAGO_ACCESS_TOKEN="TEST-..."
MERCADOPAGO_WEBHOOK_SECRET="..."

# 4. Mode Flags
DEMO_MODE=false
NEXT_PUBLIC_IS_DEMO=false
