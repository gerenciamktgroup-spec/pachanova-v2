# PachaNova V2.0 — Environment Variables Template

# Local cofinanciamiento DB (docker compose). Do not reuse the old dead cloud project.
#   docker compose up -d db
#   Get-Content supabase/migrations/20260822000000_cofinanciamiento_init.sql | docker exec -i pachanova_db psql -U postgres -d pachanova
DATABASE_URL="postgresql://postgres:pachanova_dev@127.0.0.1:5433/pachanova"
DIRECT_URL="postgresql://postgres:pachanova_dev@127.0.0.1:5433/pachanova"

# Optional later: new Supabase cloud (Auth). Leave blank until a NEW project exists.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# 2. Authentication (NextAuth)
AUTH_SECRET="your-next-auth-secret-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Payments (MercadoPago)
MERCADOPAGO_ACCESS_TOKEN="TEST-..."
MERCADOPAGO_WEBHOOK_SECRET="..."

# 4. Mode Flags
DEMO_MODE=false
NEXT_PUBLIC_IS_DEMO=false
