# Private key of the deployer wallet (Must be funded with testnet ETH)
DEPLOYER_PRIVATE_KEY=0xabc123...

# RPC URL for Arbitrum Sepolia (e.g. from Alchemy, Infura, or QuickNode)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# RPC URL for Arbitrum One (Mainnet - optional during testnet deployment)
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc

# API key for Arbiscan verification (obtain from arbiscan.io)
ARBISCAN_API_KEY=your_arbiscan_api_key_here

# Address of the fiduciary multisig or wallet
FIDUCIARIO_ADDRESS=0x0000000000000000000000000000000000000000

# Address of the contract owner / admin wallet
ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
